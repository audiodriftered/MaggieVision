<Page
    x:Class="MaggieVision_Windows.Music.MusicHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ProvisionalShellBrush}"
    SizeChanged="OnPageSizeChanged">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ContentRoot" Padding="32,24,32,32" Spacing="14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Music" FontSize="36" FontWeight="SemiBold" />
                    <TextBlock x:Name="LibrarySummary" Foreground="{ThemeResource ProvisionalSecondaryTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Spacing="10">
                    <Button x:Name="ArtistsButton" Click="OnArtistsClick" Content="Browse Artists" />
                    <Button Click="OnViewModeClick" AutomationProperties.Name="Toggle grid or list view"><FontIcon x:Name="ViewModeGlyph" Glyph="&#xF0E2;" /></Button>
                    <Button Click="OnSearchClick" AutomationProperties.Name="Search music"><FontIcon Glyph="&#xE721;" /></Button>
                </StackPanel>
            </Grid>
            <TextBox x:Name="SearchBox" PlaceholderText="Search artists, albums and tracks" Visibility="Collapsed" TextChanged="OnSearchChanged" />
            <StackPanel x:Name="RowsRoot" Spacing="8" />
        </StackPanel>
    </ScrollViewer>
</Page>
