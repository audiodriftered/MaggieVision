<Page
    x:Class="MaggieVision_Windows.Music.MusicNowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ProvisionalShellBrush}">
    <Grid x:Name="ContentRoot">
        <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.58" />
        <Rectangle Fill="#99101A29" />
        <Grid Padding="56,36">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="18" MaxWidth="1240">
                <TextBlock x:Name="TrackTitle" FontSize="34" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="TrackSubtitle" FontSize="20" Foreground="{ThemeResource ProvisionalSecondaryTextBrush}" TextAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18">
                    <RatingControl x:Name="TrackRating" MaxRating="5" ValueChanged="OnRatingChanged" AutomationProperties.Name="Track rating" />
                    <Button Click="OnFavouriteClick" AutomationProperties.Name="Toggle track favourite"><FontIcon x:Name="FavouriteGlyph" Glyph="&#xEB52;" /></Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18">
                    <Button x:Name="ShuffleButton" Click="OnShuffleClick" AutomationProperties.Name="Toggle shuffle"><FontIcon Glyph="&#xE8B1;" /></Button>
                    <Button Click="OnPreviousClick" AutomationProperties.Name="Previous track"><FontIcon Glyph="&#xE892;" /></Button>
                    <Button x:Name="PlayPauseButton" Click="OnPlayPauseClick" Width="62" Height="62" AutomationProperties.Name="Play or pause"><FontIcon x:Name="PlayPauseGlyph" Glyph="&#xE768;" FontSize="20" /></Button>
                    <Button Click="OnNextClick" AutomationProperties.Name="Next track"><FontIcon Glyph="&#xE893;" /></Button>
                    <Button x:Name="RepeatButton" Click="OnRepeatClick" AutomationProperties.Name="Cycle repeat mode"><FontIcon x:Name="RepeatGlyph" Glyph="&#xE8EE;" /></Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="Elapsed" Text="0:00" VerticalAlignment="Center" />
                    <Slider x:Name="Progress" Minimum="0" Maximum="20" ValueChanged="OnProgressChanged" VerticalAlignment="Center" HorizontalAlignment="Stretch" AutomationProperties.Name="Playback position" />
                    <TextBlock x:Name="Remaining" Text="0:20" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="Visualizer" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="7" Height="44" AutomationProperties.Name="Audio spectrum visualiser" />
                <TextBlock x:Name="PlaybackStatus" Text="Spectrum is calculated from the currently playing synthetic PCM sample." FontSize="12" Foreground="{ThemeResource ProvisionalSecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
                <Button Content="Equaliser" Tag="equaliser" Click="OnOverlayClick" />
                <Button Content="Track details" Tag="details" Click="OnOverlayClick" />
                <Button Content="Lyrics" Tag="lyrics" Click="OnOverlayClick" />
                <Button Content="Queue" Tag="queue" Click="OnOverlayClick" />
            </StackPanel>
        </Grid>
        <Border x:Name="OverlayHost" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="360" Margin="0,24,24,24" Padding="18" Background="#E61A2633" BorderBrush="{ThemeResource ProvisionalSegmentBorderBrush}" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="OverlayTitle" FontSize="22" FontWeight="SemiBold" />
                    <Button Content="Close" HorizontalAlignment="Right" Click="OnCloseOverlayClick" />
                </Grid>
                <ListView x:Name="QueueList" Grid.Row="1" SelectionChanged="OnQueueSelectionChanged" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                    <Button Content="Move up" Click="OnMoveQueueUp" />
                    <Button Content="Move down" Click="OnMoveQueueDown" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
