<Page
    x:Class="MaggieVision_Windows.Music.MusicArtistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ProvisionalShellBrush}"
    SizeChanged="OnPageSizeChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ContentRoot" Padding="32,24,32,32" Spacing="16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Artists" FontSize="36" FontWeight="SemiBold" />
                    <TextBlock x:Name="ArtistSummary" Foreground="{ThemeResource ProvisionalSecondaryTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Spacing="10">
                    <ComboBox x:Name="SortSelector" SelectedIndex="0" SelectionChanged="OnSortChanged" AutomationProperties.Name="Sort artists">
                        <ComboBoxItem Content="Name A–Z"/><ComboBoxItem Content="Name Z–A"/><ComboBoxItem Content="Most albums"/>
                    </ComboBox>
                    <Button Click="OnViewModeClick" AutomationProperties.Name="Toggle grid or list view"><FontIcon x:Name="ViewModeGlyph" Glyph="&#xE8A9;" /></Button>
                    <Button Click="OnSearchClick" AutomationProperties.Name="Search artists"><FontIcon Glyph="&#xE721;" /></Button>
                </StackPanel>
            </Grid>
            <TextBox x:Name="SearchBox" PlaceholderText="Search artists" Visibility="Collapsed" TextChanged="OnSearchChanged" />
            <Grid x:Name="LetterBar" ColumnSpacing="3" />
            <StackPanel x:Name="ArtistCards" Spacing="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
