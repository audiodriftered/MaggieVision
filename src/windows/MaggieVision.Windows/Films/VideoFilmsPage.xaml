<Page
    x:Class="MaggieVision_Windows.Video.Films.VideoFilmsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ProvisionalShellBrush}"
    SizeChanged="OnPageSizeChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="FilmsContent" Spacing="16" Padding="24,0,24,28">
            <Grid MinHeight="58" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Films" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource ProvisionalPrimaryTextBrush}" />
                    <TextBlock Text="Synthetic demonstration catalogue" FontSize="13" Foreground="{ThemeResource ProvisionalSecondaryTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <ToggleButton x:Name="GridModeButton" IsChecked="True" Click="OnGridModeClick" AutomationProperties.Name="Grid view">
                        <SymbolIcon Symbol="ViewAll" />
                    </ToggleButton>
                    <ToggleButton x:Name="ListModeButton" Click="OnListModeClick" AutomationProperties.Name="List view">
                        <SymbolIcon Symbol="Bullets" />
                    </ToggleButton>
                    <ComboBox x:Name="GenreFilter" Width="146" Header="Genre" SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="All Genres" IsSelected="True" />
                    </ComboBox>
                    <ComboBox x:Name="SortFilter" Width="160" Header="Sort by" SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="Recently Added" IsSelected="True" Tag="RecentlyAdded" />
                        <ComboBoxItem Content="Title" Tag="Title" />
                        <ComboBoxItem Content="Year" Tag="Year" />
                    </ComboBox>
                    <TextBox x:Name="FilmSearch" Width="190" PlaceholderText="Search films" AutomationProperties.Name="Search films" TextChanged="OnSearchChanged" />
                </StackPanel>
            </Grid>

            <Border CornerRadius="8">
            <Grid x:Name="FeaturedPanel" Height="260" SizeChanged="OnFeaturedSizeChanged">
                <Image x:Name="FeaturedImage" Stretch="UniformToFill" />
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#F2071524" Offset="0" />
                            <GradientStop Color="#D9071524" Offset="0.50" />
                            <GradientStop Color="#00071524" Offset="0.90" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel x:Name="FeaturedCopy" Width="610" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="8" Padding="24,16">
                    <TextBlock Text="FEATURED FILM" FontSize="12" FontWeight="Bold" CharacterSpacing="140" Foreground="{ThemeResource ProvisionalAccentBrush}" />
                    <TextBlock x:Name="FeaturedTitle" FontSize="38" FontWeight="Bold" Foreground="{ThemeResource ProvisionalPrimaryTextBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="FeaturedMetadata" FontSize="14" Foreground="{ThemeResource ProvisionalPrimaryTextBrush}" />
                    <TextBlock x:Name="FeaturedSynopsis" FontSize="14" MaxWidth="500" TextWrapping="Wrap" Foreground="{ThemeResource ProvisionalPrimaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Button Content="Play" Click="OnUnavailableActionClick" />
                        <Button Content="More Info" Click="OnFeaturedDetailsClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock Text="Resume Watching" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource ProvisionalPrimaryTextBrush}" />
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ResumeCards" Orientation="Horizontal" Spacing="14" />
                </ScrollViewer>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Recently Added" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource ProvisionalPrimaryTextBrush}" />
                <ScrollViewer x:Name="ResultsScroll" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FilmCards" Orientation="Horizontal" Spacing="14" />
                </ScrollViewer>
                <TextBlock x:Name="EmptyResults" Text="No demonstration films match these filters." Visibility="Collapsed" Foreground="{ThemeResource ProvisionalSecondaryTextBrush}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Popular Films" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource ProvisionalPrimaryTextBrush}" />
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PopularCards" Orientation="Horizontal" Spacing="14" />
                </ScrollViewer>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Browse by Genre" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource ProvisionalPrimaryTextBrush}" />
                <ItemsControl x:Name="GenreButtons">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <InfoBar x:Name="ActionMessage" IsOpen="False" IsClosable="True" Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
