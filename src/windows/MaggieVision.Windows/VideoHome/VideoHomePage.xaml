<Page
    x:Class="MaggieVision_Windows.VideoHome.VideoHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ProvisionalShellBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="HomeContent" Spacing="16" Padding="22,0,28,24" SizeChanged="OnHomeContentSizeChanged">
            <Grid x:Name="FeaturedPanel" Height="278">
                <Image x:Name="FeaturedImage" Stretch="UniformToFill" />
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#F2071524" Offset="0" />
                            <GradientStop Color="#CE071524" Offset="0.43" />
                            <GradientStop Color="#00071524" Offset="0.76" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Grid Padding="26,20,24,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="FeaturedCopy" Width="570" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="▏ FEATURED FILM" FontSize="13" FontWeight="Bold" CharacterSpacing="140" Foreground="{ThemeResource ProvisionalAccentBrush}" />
                        <TextBlock x:Name="FeaturedTitle" Text="The Amber Horizon" FontSize="38" FontWeight="Bold" TextWrapping="Wrap" Foreground="{ThemeResource ProvisionalPrimaryTextBrush}" />
                        <TextBlock x:Name="FeaturedMetadata" Text="2024  ·  Adventure / Drama  ·  2 h 9 min     4K  HDR" FontSize="14" Foreground="{ThemeResource ProvisionalPrimaryTextBrush}" />
                        <TextBlock x:Name="FeaturedDescription" Text="A map, a mystery and a final journey across a forgotten land bring two estranged siblings back together." FontSize="15" MaxWidth="520" TextWrapping="Wrap" Foreground="{ThemeResource ProvisionalPrimaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,7,0,0">
                            <Button Content="▶   Play" IsTabStop="False" Background="{ThemeResource ProvisionalAccentStrongBrush}" Foreground="{ThemeResource ProvisionalAccentTextBrush}" Padding="22,8" />
                            <Button Content="ⓘ   More Info" IsTabStop="False" Background="Transparent" Foreground="{ThemeResource ProvisionalPrimaryTextBrush}" Padding="18,8" />
                            <Button Content="♧" IsTabStop="False" Background="Transparent" Foreground="{ThemeResource ProvisionalPrimaryTextBrush}" AutomationProperties.Name="Add to Watchlist" />
                            <Button Content="♡" IsTabStop="False" Background="Transparent" Foreground="{ThemeResource ProvisionalPrimaryTextBrush}" AutomationProperties.Name="Add to Favourites" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" AutomationProperties.Name="Featured film position">
                        <Ellipse Width="10" Height="10" Fill="{ThemeResource ProvisionalAccentBrush}" />
                        <Ellipse Width="10" Height="10" Fill="{ThemeResource ProvisionalSecondaryTextBrush}" />
                        <Ellipse Width="10" Height="10" Fill="{ThemeResource ProvisionalSecondaryTextBrush}" />
                        <Ellipse Width="10" Height="10" Fill="{ThemeResource ProvisionalSecondaryTextBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock Text="Continue Watching" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource ProvisionalPrimaryTextBrush}" />
                    <Button Content="›" HorizontalAlignment="Right" Padding="8,0" IsTabStop="False" AutomationProperties.Name="Show more Continue Watching items" Click="OnContinueWatchingNextClick" />
                </Grid>
                <ScrollViewer x:Name="ContinueWatchingScrollViewer" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ContinueWatchingCards" Orientation="Horizontal" Spacing="14" />
                </ScrollViewer>
            </StackPanel>
            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock Text="Recently Added Films" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource ProvisionalPrimaryTextBrush}" />
                    <Button Content="›" HorizontalAlignment="Right" Padding="8,0" IsTabStop="False" AutomationProperties.Name="Show more recently added films" Click="OnRecentFilmsNextClick" />
                </Grid>
                <ScrollViewer x:Name="RecentFilmsScrollViewer" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="RecentFilmCards" Orientation="Horizontal" Spacing="14" />
                </ScrollViewer>
            </StackPanel>
            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock Text="Recently Added TV Programmes" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource ProvisionalPrimaryTextBrush}" />
                    <Button Content="›" HorizontalAlignment="Right" Padding="8,0" IsTabStop="False" AutomationProperties.Name="Show more recently added TV programmes" Click="OnRecentProgrammesNextClick" />
                </Grid>
                <ScrollViewer x:Name="RecentProgrammesScrollViewer" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="RecentProgrammeCards" Orientation="Horizontal" Spacing="14" />
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
