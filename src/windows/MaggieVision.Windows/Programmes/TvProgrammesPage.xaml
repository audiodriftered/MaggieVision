<Page
    x:Class="MaggieVision_Windows.Video.Programmes.TvProgrammesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ContentRoot" Padding="30" Spacing="20" SizeChanged="OnSizeChanged">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="TV Programmes" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock x:Name="LibraryCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <RadioButton Content="Recommended" IsChecked="True" Tag="recommended" Click="OnViewClick" />
                    <RadioButton Content="Browse" Tag="browse" Click="OnViewClick" />
                    <Button x:Name="SearchButton" Content="Search" AutomationProperties.Name="Search TV programmes" Click="OnSearchClick" />
                    <TextBox x:Name="SearchBox" PlaceholderText="Search TV programmes" Width="260" Visibility="Collapsed" TextChanged="OnSearchChanged" />
                </StackPanel>
            </Grid>
            <StackPanel x:Name="ContinueSection" Spacing="10">
                <TextBlock Text="Continue Watching" FontSize="21" FontWeight="SemiBold" />
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                    <StackPanel x:Name="ContinueCards" Orientation="Horizontal" Spacing="12" />
                </ScrollViewer>
            </StackPanel>
            <StackPanel x:Name="ResumeSection" Spacing="10">
                <TextBlock Text="Resume Watching" FontSize="21" FontWeight="SemiBold" />
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                    <StackPanel x:Name="ResumeCards" Orientation="Horizontal" Spacing="12" />
                </ScrollViewer>
            </StackPanel>
            <StackPanel Spacing="10">
                <TextBlock Text="Recently Added TV Programmes" FontSize="21" FontWeight="SemiBold" />
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                    <StackPanel x:Name="RecentCards" Orientation="Horizontal" Spacing="12" />
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
